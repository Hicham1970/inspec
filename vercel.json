{
  "version": 2,
  "functions": {
    "api/test.js": {
      "runtime": "@vercel/node@3"
    },
    "api/newsletter.js": {
      "runtime": "@vercel/node@3"
    },
    "api/contact.js": {
      "runtime": "@vercel/node@3"
    },
    "api/newsletter-api.js": {
      "runtime": "@vercel/node@3"
    }
  },
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "buildCommand": "npm run build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/test",
      "dest": "/api/test.js"
    },
    {
      "src": "/api/newsletter",
      "dest": "/api/newsletter.js"
    },
    {
      "src": "/api/contact",
      "dest": "/api/contact.js"
    },
    {
      "src": "/api/newsletter-api",
      "dest": "/api/newsletter-api.js"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/dist/$1"
    }
  ]
}
